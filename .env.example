# ULTRAMETRICA — Optional Local Server Configuration (Build Standard A33)
# Copy to .env if overriding defaults; no secrets or external API keys are ever required.

# Local TCP port for server.mjs (integer 0..65535; default: 4173)
PORT=4173

# Local bind interface for server.mjs (default: 127.0.0.1)
HOST=127.0.0.1

# Log format for server.mjs: 'text' (default) or 'json' (structured JSON lines)
LOG_FORMAT=text
